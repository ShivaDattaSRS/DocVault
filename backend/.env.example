# ---------- App ----------
APP_NAME=DocVault
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------- Database ----------
DATABASE_URL=postgresql+psycopg://docvault:docvault@localhost:5432/docvault

# ---------- Redis (optional; falls back to an in-process thread worker) ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Storage ----------
STORAGE_DIR=../storage
MAX_FILE_SIZE_MB=50
DEFAULT_QUOTA_MB=512

# ---------- SMTP (OTP delivery) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@example.com
SMTP_TLS=true
# When true, OTPs are printed to the server console instead of emailed (dev mode)
SMTP_CONSOLE_FALLBACK=true

# ---------- OTP ----------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ---------- Bootstrap admin ----------
ADMIN_EMAIL=admin@example.com
